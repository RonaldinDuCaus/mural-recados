rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function validNote() {
      let d = request.resource.data;
      return d.keys().hasAll(['title','body','category','color','authorId','authorName','createdAt','updatedAt'])
        && d.keys().hasOnly(['title','body','category','color','authorId','authorName','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.title.matches('.*[^ ].*')
        && d.body is string && d.body.size() > 0 && d.body.size() <= 1000
        && d.category in ['recado','aviso','lembrete']
        && d.color in ['mel','rosa','lavanda','azul']
        && d.authorId is string && d.authorId == request.auth.uid
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 40
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.updatedAt == request.time;
    }
    match /recados/{noteId} {
      // O mural é compartilhado entre pessoas autenticadas.
      allow read: if signedIn();
      allow create: if signedIn() && validNote()
        && request.resource.data.createdAt == request.time;
      // Somente quem escreveu pode editar; autoria e criação são imutáveis.
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && validNote()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
    // Nenhum outro caminho tem permissão de acesso.
  }
}
